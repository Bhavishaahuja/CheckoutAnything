# Copy to .env.local (git ignores it) and change what you need.

# Where the Leash API lives. Local backend, or https://leash-api-q3rw.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# true = fake data, no backend needed. false = call VITE_API_URL
VITE_USE_MOCKS=true

# AG Grid Enterprise trial key, for group by agent. leave empty for a watermark instead
VITE_AG_GRID_LICENSE_KEY=

# Where the Checkout Anything app (frontend/ at the repo root) is served. Its review drawer shows
# the confirm page in an iframe: this is the only site allowed to do that, and the only one the
# confirm page tells when a decision is made. Left empty, the page can't be framed by anyone else.
VITE_CONNECT_URL=http://localhost:5173
