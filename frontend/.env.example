# Copy to .env.local (git ignores it) and change what you need.
# Where the Checkout Anything API lives
VITE_API_URL=http://127.0.0.1:8000

# true = no backend needed, the UI plays scripted demo runs (shows a "Mock data" badge)
VITE_USE_MOCK=false

# The shared header links the two apps to each other. Where the Check app (check/frontend) is
# served, for the header's Check link. Locally that is its Vite dev server.
VITE_CHECK_URL=http://localhost:5175
# Where this app is served. The Check app reads the same variable to link back here.
VITE_CONNECT_URL=http://localhost:5173
