# Copy to .env.local (git ignores it) and change what you need.
# Where the Checkout Anything API lives
VITE_API_URL=http://127.0.0.1:8000

# true = no backend needed, the UI plays scripted demo runs (shows a "Mock data" badge)
VITE_USE_MOCK=false

# Where the Leash API lives (the Intent review grid on the Orders screen talks to it).
# Leash only answers browsers from the sites in its own FRONTEND_ORIGINS, so this app's URL
# has to be on that list
VITE_LEASH_API_URL=http://127.0.0.1:8001
