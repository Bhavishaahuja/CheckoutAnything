# Copy to .env and fill in. Never commit .env. Sandbox credentials only.
#
# This file is for the Connect service (backend/). The Check service (in check/) reads its own file: copy
# check/.env.example to check/.env. dev.cmd runs the Check API on port 8001, so for the Check
# frontend set VITE_API_URL=http://127.0.0.1:8001 in check/frontend/.env

# PayPal sandbox app (developer.paypal.com > Apps & Credentials, Sandbox toggle on).
# The app needs Vault turned on (app settings > Features > Vault).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The app refuses to start with anything but the sandbox here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# The saved sandbox buyer wallet the buy endpoint pays with. Run this once and approve in the
# browser as your sandbox buyer, it prints the id:
#   python backend/scripts/setup_vault.py
# Left empty, buying returns 503.
BUYER_VAULT_ID=

# Anthropic (console.anthropic.com > API Keys). Not needed for replay mode.
ANTHROPIC_API_KEY=

# Check: hold the shopping agent's payment until the order is shown to be what the human asked
# for. CHECK_URL is the switch. Left empty, agent orders are paid and captured here, as before,
# and the three settings under it aren't used.
#   CHECK_URL=http://127.0.0.1:8001
CHECK_URL=
# One of the Check service's AGENT_API_KEYS (check/.env). Give that key a name there, like
# <key>:Checkout Anything, and put the same name in its STORE_NAMING_AGENTS, or Check ignores
# the store name and holds every order for review.
CHECK_AGENT_KEY=
# The Check service's MERCHANT_API_KEY. Shows why an order was held, makes review links and runs
# the Disputes tab. Left empty, orders still go through Check but the grid can't say why.
CHECK_MERCHANT_KEY=
# Where the Check frontend is served, for the buyer's confirm page: <this>/confirm/<token>
CHECK_FRONTEND_URL=

# Left empty, a local sqlite file is used (checkout_anything.db). For a Render Postgres paste
# its Internal Database URL as is (postgres://...), the app switches it to the psycopg driver
DATABASE_URL=

# Which sites' browsers may call the API, comma-separated. No wildcard: a * gets ignored.
FRONTEND_ORIGINS=http://localhost:5173

# Where the three demo stores are served. POST /demo/reset connects <base>/<slug>/
DEMO_STORES_BASE_URL=http://localhost:5174

# live: fetch the page and call Claude. replay: replay recorded fixtures instead (PayPal
# calls still run for real). The UI toggle overrides this per connect.
DEMO_MODE=live
# Set to 1 while connecting the demo stores live to save each run to backend/fixtures
RECORD_FIXTURES=0

# Local dev only. The fetcher blocks private addresses, this lets it read the demo stores on
# your own machine. Leave it empty on a hosted deploy.
FETCH_ALLOW_HOSTS=localhost:5174
